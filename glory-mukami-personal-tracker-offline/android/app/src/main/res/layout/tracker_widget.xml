<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_water"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFAF2"
        android:textSize="24sp"
        android:textStyle="bold"
        android:text="—" />

    <TextView
        android:id="@+id/widget_water_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#C7FFFAF2"
        android:textSize="12sp"
        android:text="" />

    <ProgressBar
        android:id="@+id/widget_water_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />

    <TextView
        android:id="@+id/widget_tasks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFFAF2"
        android:textSize="13sp"
        android:text="" />

    <TextView
        android:id="@+id/widget_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#F4C766"
        android:textSize="13sp"
        android:text="" />
</LinearLayout>
