# Copy to .env and fill in. Nothing here has a safe default, which is why the
# server refuses to sign anyone in rather than guessing.

# ---------------------------------------------------------------------------
# Required: the database holding your journal and your account.
# ---------------------------------------------------------------------------
# MongoDB Atlas connection string. The free M0 tier is ample for a personal
# journal (512MB), but note it has NO automated backups and pauses after ~60
# days idle — see scripts/backup-mongo.sh.
MONGODB_URI=

# ---------------------------------------------------------------------------
# Required: signs the session cookie.
# ---------------------------------------------------------------------------
# At least 16 characters, random, and secret. Anyone who learns this can mint a
# session for any account, so do not reuse it or commit it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ---------------------------------------------------------------------------
# Google Sign-In — what makes an account survive reinstalling the app.
# ---------------------------------------------------------------------------
# From https://console.cloud.google.com/apis/credentials
#
# Create TWO OAuth client IDs in the SAME project:
#
#   1. "Web application"  -> GOOGLE_CLIENT_ID
#      Used by the browser, AND it is the audience of the token the Android
#      app sends. This is the one Android passes as its `serverClientId`.
#
#   2. "Android"          -> GOOGLE_CLIENT_ID_ANDROID
#      Needs your package name and the SHA-1 of the signing certificate.
#      It authorises your app with Google; it is NOT usually the token's
#      audience, so this is set as a safety net rather than the main path.
#
# GOOGLE_CLIENT_ID is therefore required for BOTH web and Android. Only ids
# listed here are accepted — an unset or wildcard audience would accept tokens
# minted for somebody else's app entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_ANDROID=

# ---------------------------------------------------------------------------
# Optional: the original Manus OAuth path. Leave blank to use Google only.
# ---------------------------------------------------------------------------
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=
DATABASE_URL=
